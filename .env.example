# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# fal.ai (real image/video generation - providers/fal_image.py,
# providers/fal_video.py). Unset = fake providers.
FAL_API_KEY=

# Chat assistant (api/routers/chat.py) rides OPENROUTER_API_KEY above - no
# separate key. Model is set via Settings UI -> Assistant (default a Claude
# model, billed through OpenRouter, not a personal claude.ai login - see
# chat.py's module docstring).

# Logical model assignments
# Keep these configurable. Free model availability can change.
CONCEPT_MODEL_A=
CONCEPT_MODEL_B=
JUDGE_MODEL=
STORY_ARCHITECT_MODEL=
EPISODE_WRITER_MODEL=
CONTINUITY_MODEL=
RETENTION_CRITIC_MODEL=
SHOT_PLANNER_MODEL=
SHOWRUNNER_MODEL=

# Runtime. "standard" = local single-user (default) - auth/authorization
# (MODULE-067) and every project-scoped role check is a no-op. "hosted"
# turns those on: POST /auth/register|login and a Bearer token become
# required for project-scoped endpoints. See docs/DEPLOYMENT.md.
XERAMA_MODE=standard
LOG_LEVEL=INFO

# Persistence (ADR-021 / ADR-022 - SQLite + local storage first).
# See docs/DEPLOYMENT.md "Hosted path" for the PostgreSQL/object-storage
# swap - unimplemented (docs/ARCHITECTURE.md section 14 defers it past
# Trial 01), documented for when it's built.
DATABASE_URL=sqlite+aiosqlite:///./xerama.db
ASSET_STORAGE_PATH=./storage

# MODULE-066 - ceiling on a single manual /assets/upload (bytes).
MAX_UPLOAD_SIZE_BYTES=209715200

# MODULE-068 - rate/concurrency/budget guards on expensive generation
# endpoints. Defaults below are permissive (standard/local mode); a
# hosted deployment should tighten these - see docs/DEPLOYMENT.md.
RATE_LIMIT_REQUESTS_PER_WINDOW=1000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CONCURRENT_PER_PROJECT=20
# Unset = unlimited. Uncomment and set a value to cap spend.
# PROJECT_BUDGET_CEILING_USD=

# Media utilities (Module 08/MODULE-032, MODULE-046) - override if
# ffmpeg isn't on PATH under this exact name. Falls back to a fake frame
# extractor/assembler when not found, so this is optional.
FFMPEG_PATH=ffmpeg
# MODULE-048 - same fallback-to-fake principle for export validation.
FFPROBE_PATH=ffprobe
# MODULE-070 - a hung/pathological ffmpeg or ffprobe process is killed
# and the request fails cleanly past this many seconds.
FFMPEG_TIMEOUT_SECONDS=300

# MODULE-055 - comma-separated origins the frontend studio shell is
# served from. Defaults to the Vite dev server; set to the real
# production origin(s) when deployed - never "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# If the CONCEPT_MODEL_A / etc. vars above are left blank, xerama/config.py
# falls back to a snapshot of OpenRouter's ":free" catalog taken 2026-08-24
# (see research/FREE_FIRST_MODEL_STRATEGY.md). Free-tier availability
# changes - re-check https://openrouter.ai/models before relying on it.
